{
  "name": "ideeza-ds",
  "version": "0.2.0",
  "description": "The IDEEZA design system — React components, design tokens and icons, built from the Figma library.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "design-tokens",
    "ideeza",
    "accessibility"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mehediuid/IDEEZA-Design-System#readme",
  "bugs": {
    "url": "https://github.com/mehediuid/IDEEZA-Design-System/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehediuid/IDEEZA-Design-System.git",
    "directory": "packages/design-system"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-package.mjs",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ideeza/icons": "workspace:*",
    "@ideeza/tokens": "workspace:*",
    "@ideeza/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@types/react": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
