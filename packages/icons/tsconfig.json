{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "declaration": true, "skipLibCheck": true, "noEmit": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true
  },
  "include": ["src", "scripts"]
}
