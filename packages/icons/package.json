{
  "name": "@ideeza/icons",
  "version": "0.1.0",
  "description": "Icons generated from the IDEEZA Figma icon library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "icons.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "fetch": "node scripts/fetch-from-figma.mjs",
    "build": "npm run generate && tsup",
    "typecheck": "tsc --noEmit",
    "import-brand": "node scripts/import-brand.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
